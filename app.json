{
  "expo": {
    "name": "Every Second Pays",
    "slug": "every-second-pays",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "everysecondpays",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/every-second-pays.icon",
      "bundleIdentifier": "software.felipe.everysecondpays"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#366E38",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "software.felipe.everysecondpays"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0F7F3",
          "dark": {
            "backgroundColor": "#141816"
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "pt-BR",
            "es",
            "fr"
          ],
          "allowDynamicLocaleChangesAndroid": true
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "84e9933c-067a-489e-b356-1526a665dbdc"
      }
    },
    "owner": "felipesoftware"
  }
}
