    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client",
    "start:production": "APP_VARIANT=production expo start",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "web": "expo start --web",
    "goldie:build:android": "bunx eas-cli build --platform android --profile screenshots --local --output goldie/build/every-second-pays-release.apk",
    "goldie:doctor": "GOLDIE_CONFIG=goldie/goldie.config.ts goldie doctor",
    "goldie:studio": "GOLDIE_CONFIG=goldie/goldie.config.ts goldie studio",
    "lint": "expo lint",
    "era": "APP_VARIANT=development expo run:android",
    "eri": "APP_VARIANT=development expo run:ios",
    "epc": "APP_VARIANT=development expo prebuild --clean"
  },
  "private": true,
  "patchedDependencies": {
    "expo-blur@57.0.3": "src/patches/expo-blur@57.0.3.patch",
    "react-native-jelly-tabs@0.0.14": "src/patches/react-native-jelly-tabs@0.0.14.patch",
    "@expo/ui@57.0.19": "src/patches/@expo%2Fui@57.0.19.patch"
