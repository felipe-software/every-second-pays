+
+  // The blur view covering this target already draws the blurred copy, so drawing the sharp copy
+  // underneath only costs GPU fill. Children are still recorded for the blur; the on-screen draw is
+  // clipped away. Software canvases (the pre-API 31 blur reads the target through one) draw as usual.
+  override fun dispatchDraw(canvas: Canvas) {
+    if (!canvas.isHardwareAccelerated) {
+      super.dispatchDraw(canvas)
+      return
+    }
+    val saveCount = canvas.save()
+    canvas.clipRect(0, 0, 0, 0)
+    super.dispatchDraw(canvas)
+    canvas.restoreToCount(saveCount)
+  }
