#!/bin/sh
# Goldie only captures pixel_9/10_pro AVDs; renaming Pixel 8's profile changes its screen, so fake it.
BIN_DIR=$(cd "$(dirname "$0")" && pwd)
REAL=$(PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vx "$BIN_DIR" | paste -sd: -) command -v adb)
if [ "$1" = "-s" ] && [ "$3 $4 $5" = "emu avd path" ]; then
  out=$("$REAL" "$@")
  case "$(printf '%s\n' "$out" | head -n 1)" in
    *Goldie_Pixel_8_API_36.avd*)
      fake="${TMPDIR:-/tmp}/goldie-pixel-8-avd"
      mkdir -p "$fake" && printf 'hw.device.name=pixel_9_pro\n' > "$fake/config.ini"
      printf '%s\nOK\n' "$fake"
      exit 0 ;;
  esac
  printf '%s\n' "$out"
  exit 0
fi
exec "$REAL" "$@"
