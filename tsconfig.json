{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "paths": {
            "@/*": ["./src/*"],
            "@/assets/*": ["./src/assets/*"],
            "react-native-noti": ["./modules/noti/src/index.ts"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
    "exclude": [
        "node_modules",
        "babel.config.js",
        "metro.config.js",
        "jest.config.js",
        "android",
        "ios",
        "tools/oxlint/anti-slop",
        "tools/oxlint/comment-policy"
    ]
}
