{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "paths": {
            "@/*": ["./src/*"],
            "@/assets/*": ["./src/assets/*"],
            "react-native-noti": ["./modules/noti/src/index.ts"],
            "theme-transition": ["./modules/theme-transition/src/index.ts"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
